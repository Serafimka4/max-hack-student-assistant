# Скопируйте в .env и заполните. Рабочие секреты в репозиторий не добавляются.
APP_PORT=8088
APP_URL=http://localhost:8088
APP_ENV=production
APP_DEBUG=false
# Пусто — ключ сгенерируется при первом запуске и сохранится в томе storage.
APP_KEY=

DB_DATABASE=max_hack
DB_USERNAME=max_hack
DB_PASSWORD=change-me

# Токен бота из платформы MAX для партнёров.
MAX_BOT_TOKEN=

# 1 — при пустой базе загрузить демонстрационные данные (вымышленные организации и учётные записи).
SEED_DEMO=1

# Мини-приложение
MINIAPP_TIMEZONE=Europe/Saratov
# Первый день семестра: нечётные недели — числитель.
MINIAPP_SEMESTER_START=2026-09-01
# На время пилота новые пользователи MAX привязываются к этому вузу (slug). Пусто — только по списку участников.
MINIAPP_ENROLL_ORGANIZATION=demo-university
MINIAPP_DEMO_DATA=true
# Кнопка «Войти как демо-студент» без MAX. В APP_ENV=production не работает.
MINIAPP_DEMO_LOGIN=false

# Cookie сессии. Если веб-версия MAX открывает приложение во встроенном окне и вход падает с ошибкой cookie,
# на HTTPS-домене включите: SESSION_SAME_SITE=none, SESSION_SECURE_COOKIE=true, SESSION_PARTITIONED_COOKIE=true.
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_PARTITIONED_COOKIE=false
